# ============================================================
# SmartOps AI — Unified Environment Configuration
# Copy this file to .env. Never commit real API keys or passwords.
# ============================================================

# LLM Execution Mode: "live" | "mock" | "replay"
# - mock: Runs completely offline with deterministic responses (zero API keys required)
# - replay: Replays verified past successful runs from disk
# - live: Calls Groq Cloud (primary) -> Google Gemini (secondary) -> Mock (fallback)
LLM_MODE=mock

# LLM API Keys (Required only if LLM_MODE=live)
GROQ_API_KEY=
GEMINI_API_KEY=

# Administrative Authentication (Protects employee dashboard APIs and trigger actions)
ADMIN_KEY=smartops-admin-2026

# Outbound Actions Security Guardrails
ENABLE_EMAIL_SEND=false
ENABLE_LINKEDIN_SCRAPE=false

# Allowed Origins (CORS allowlist for localhost demo services)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:8080,http://localhost:8765,http://localhost:8000

# Service Ports:
# Hub: 8080
# Customer Support API: 8000
# Customer Portal UI: 5173
# Employee Dashboard UI: 5174
# Sales Outreach Dashboard: 5175
# Voice Agent (WebSocket + UI): 8765
